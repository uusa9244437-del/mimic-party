# Optional: add an API key to enable model-based audio judging.
# Keep this key only on the server. Never put it in public/app.js.
OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=gpt-4o-audio-preview
PORT=3000
MAX_UPLOAD_MB=18

# Optional TURN server for networks where direct WebRTC/STUN connections fail.
# Use credentials from your TURN provider (prefer short-lived credentials in production).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
